# This file documents environment equivalents and is not loaded automatically.

# Configuration file path
TRADEFOG_CONFIG=/path/to/settings.toml

# Application
TRADEFOG_APPLICATION__APP_NAME=Tradefog
TRADEFOG_APPLICATION__DEBUG=false
TRADEFOG_APPLICATION__SECRET_KEY=!required
TRADEFOG_APPLICATION__API_PREFIX=/api/v1
TRADEFOG_APPLICATION__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000"]

# Authentication & JWT
TRADEFOG_AUTHENTICATION__JWT_SECRET_KEY=!required
TRADEFOG_AUTHENTICATION__ALGORITHM=HS256
TRADEFOG_AUTHENTICATION__ACCESS_TOKEN_EXPIRE_MINUTES=15
TRADEFOG_AUTHENTICATION__REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
TRADEFOG_DATABASE__ACTIVE=sqlite

# SQLite
TRADEFOG_DATABASE__SQLITE__PATH=/path/to/tradefog.db

# PostgreSQL
TRADEFOG_DATABASE__PSQL__NAME=tradefog
TRADEFOG_DATABASE__PSQL__USER=tradefog
TRADEFOG_DATABASE__PSQL__PASSWORD=!required
TRADEFOG_DATABASE__PSQL__HOST=localhost
TRADEFOG_DATABASE__PSQL__PORT=5432

# Logging
TRADEFOG_LOGGING__LEVEL=INFO
TRADEFOG_LOGGING__DIAGNOSE=false
TRADEFOG_LOGGING__BACKTRACE=true

# User-uploaded media
TRADEFOG_MEDIA__URL=/media/
TRADEFOG_MEDIA__ROOT=/path/to/media
TRADEFOG_MEDIA__MAX_ATTACHMENT_SIZE_MIB=10

# Uvicorn server execution
TRADEFOG_UVICORN__HOST=127.0.0.1
TRADEFOG_UVICORN__PORT=8000
TRADEFOG_UVICORN__RELOAD=false
TRADEFOG_UVICORN__WORKERS=1
