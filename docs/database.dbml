// Tradefog database (revised: owner-scoped reusable strategies)
// Two ownership zones: shared staff catalog, owner-scoped journal.
//
// Three conceptual layers for risk and money:
//   Edge layer      TradingStrategy   risk_percent + reward_multiple (R:R).
//                    Trading skill is measured in dimensionless R and is
//                    therefore currency-agnostic.
//   Allocation layer StrategyCapital   fixed capital per wallet asset a strategy
//                    commits to trade; one row per (strategy, wallet_asset).
//   Money layer      Wallet/WalletAsset  balances plus the advisory deposit
//                    floor risk_stop_capital; deposit health is per asset,
//                    global to the user, and never blocks a trade.

Enum asset_type {
  crypto
  equity
  fiat
}

Enum product_kind {
  spot
  perpetual_future
  cash_equity
}

Enum atr_source {
  auto
  manual
}

Enum market_data_provider {
  none
  bybit
  binance
  yfinance
}

Enum trade_status {
  draft
  pending_entry
  open
  closed
  cancelled
}

Enum direction {
  long
  short
}

Enum strategy_status {
  active
  at_risk
  risk_stopped
}

Enum wallet_asset_status {
  active
  at_risk
  risk_stopped
}

Enum wallet_operation_kind {
  deposit
  withdrawal
}

// ---------------------------------------------------------------------------
// Shared reference catalog (staff-managed)
// ---------------------------------------------------------------------------

Table users {
  id integer [pk, increment, note: 'Primary key']
  username varchar(150) [unique, not null, note: 'Login identifier']
  password varchar(128) [not null, note: 'Hashed password']
  is_staff boolean [default: false, not null, note: 'Grants write access to the shared catalog']
  is_active boolean [default: true, not null, note: 'Account enabled flag']
  Note: 'Authenticated user. Journal data is owner-scoped; only staff edit the catalog.'
}

Table Asset {
  id integer [pk, increment, note: 'Primary key']
  symbol varchar(32) [not null, note: 'Normalized symbol, unique installation-wide, case-insensitive']
  name varchar(255) [note: 'Human-readable display name']
  asset_type asset_type [not null, note: 'Unambiguous type: Crypto, Equity, or Fiat']
  Note: 'Shared global asset identity. Reused across all venues; a symbol maps to exactly one asset.'
  indexes {
    (symbol) [unique, name: 'asset_symbol_idx']
  }
}

Table TradingPair {
  id integer [pk, increment, note: 'Primary key']
  base_id integer [not null, note: 'Base asset of the pair']
  quote_id integer [not null, note: 'Quote asset of the pair']
  canonical_symbol varchar(32) [unique, not null, note: 'Normalized identity, e.g. BTC/USD']
  Note: 'Reusable logical BASE/QUOTE market. Carries no execution parameters; entered once for the whole installation.'
  indexes {
    (base_id, quote_id) [unique, name: 'trading_pair_base_quote_idx', note: 'One logical pair per base/quote combination']
  }
}

Table Venue {
  id integer [pk, increment, note: 'Primary key']
  name varchar(128) [not null, note: 'Exchange or broker name, unique']
  market_data_provider market_data_provider [default: 'none', not null, note: 'Provider used for on-demand market candles and ATR context']
  description text [note: 'Optional short description or operational context for this venue']
  website varchar(255) [note: 'Optional venue website URL']
  is_active boolean [default: true, not null, note: 'Availability for creating new profiles; deactivation moves venue to archives']
  Note: 'Shared execution destination. Carries no market class; markets are derived from its instruments.'
  indexes {
    (name) [unique, name: 'venue_name_idx']
  }
}


Table VenueInstrument {
  id integer [pk, increment, note: 'Primary key']
  venue_id integer [not null, note: 'Venue hosting this executable market']
  pair_id integer [not null, note: 'Underlying logical trading pair']
  product product_kind [not null, note: 'Spot/Perpetual Future/Cash Equity; implies market class']
  exec_symbol varchar(64) [not null, note: 'Exchange execution symbol, e.g. BTCUSDT']
  price_step decimal(30, 18) [not null, note: 'Minimum price tick']
  qty_step decimal(30, 18) [not null, note: 'Minimum quantity increment']
  min_qty decimal(30, 18) [note: 'Minimum order quantity']
  min_notional decimal(30, 18) [note: 'Minimum order notional']
  settlement_asset_id integer [note: 'Explicit settlement for linear; spot/cash derive it from quote']
  is_active boolean [default: true, not null, note: 'Tradable availability; delisting deactivates this, never deletes historical identity']
  Note: 'The only record holding per-venue, per-product execution parameters. Asset and pair stay shared, never duplicated.'
  indexes {
    (venue_id, pair_id, product) [unique, name: 'venue_instrument_venue_pair_product_idx', note: 'One product per pair per venue']
    (venue_id, exec_symbol) [unique, name: 'venue_instrument_venue_exec_symbol_idx', note: 'Execution symbol unique within a venue']
  }
}

Table VenueWalletAsset {
  id integer [pk, increment, note: 'Primary key']
  venue_id integer [not null, note: 'Venue the asset can settle on']
  asset_id integer [not null, note: 'Shared asset usable as wallet/settlement']
  is_active boolean [default: true, not null, note: 'Venue settlement capability availability; delisting deactivates this']
  Note: 'Deliberate subset of assets that are settlement-capable on a venue.'
  indexes {
    (venue_id, asset_id) [unique, name: 'venue_wallet_asset_venue_asset_idx']
  }
}

// ---------------------------------------------------------------------------
// User journal (owner-scoped)
// ---------------------------------------------------------------------------

Table TradingProfile {
  id integer [pk, increment, note: 'Primary key']
  owner_id integer [not null, note: 'Owning user; the single ownership root for all journal data below this profile']
  venue_id integer [not null, note: 'Venue this profile is bound to; the profile trades only this venue instrument and holds only its wallet assets']
  name varchar(128) [not null, note: 'Profile name, e.g. Bybit Main']
  description text [note: 'Optional trading context description']
  is_archived boolean [default: false, not null, note: 'Soft-archived, no longer used for new activity']
  Note: 'Owner-scoped journal context owning wallet, strategies, and trades. owner_id is the single source of truth for ownership; all child records scope through this profile. Bound to one venue. Reuses shared catalog without copying it.'
}

Table Wallet {
  id integer [pk, increment, note: 'Primary key']
  profile_id integer [unique, not null, note: 'Exactly one wallet per profile']
  Note: 'The profile wallet, one-to-one with its profile. Holds no money itself; it groups WalletAsset balances. A global wallet is a UI-only aggregation over the profile wallets of the user.'
}

Table WalletAsset {
  id integer [pk, increment, note: 'Primary key']
  wallet_id integer [not null, note: 'Owning wallet; owner is the profile owner (single ownership root)']
  venue_wallet_asset_id integer [not null, note: 'Venue-capable asset this balance holds; its venue equals the profile venue']
  risk_stop_capital decimal(30, 18) [note: 'Advisory deposit floor; editable; global per asset. Highlights a bleeding deposit but never blocks a trade.']
  status wallet_asset_status [not null, note: 'Derived from balance against the floor; persisted and recomputed by a domain service']
  is_archived boolean [default: false, not null, note: 'Soft-archived asset; hidden from active wallet views when balance is zero']
  Note: 'A balance for one asset available on the profile venue, plus the money-layer deposit floor. References VenueWalletAsset so the asset is structurally venue-capable for the profile. Ownership is scoped transitively through the wallet and profile.'
  indexes {
    (wallet_id, venue_wallet_asset_id) [unique, name: 'wallet_asset_wallet_venue_asset_idx']
  }
}

Table WalletOperation {
  id integer [pk, increment, note: 'Primary key']
  wallet_asset_id integer [not null, note: 'Wallet asset affected; owner scoped through its wallet and profile']
  kind wallet_operation_kind [not null, note: 'Deposit or withdrawal']
  amount decimal(30, 18) [not null, note: 'Signed amount moved in or out']
  note varchar(255) [note: 'Optional free-text note']
  created_at timestamp [default: `now()`, not null, note: 'Operation time']
  Note: 'Journal fact introducing or removing virtual funds. Not an exchange action. Ownership is scoped transitively through TradingProfile.owner.'
}

Table TradingStrategy {
  id integer [pk, increment, note: 'Primary key']
  profile_id integer [not null, note: 'Owning profile; the strategy is a tool of the profile, not a shared catalog record']
  name varchar(128) [not null, note: 'Strategy name, e.g. Easy']
  description text [note: 'Strategy description']
  risk_percent decimal(10, 6) [not null, note: 'Risk percent of the per-asset allocation capital per trade']
  reward_multiple decimal(10, 6) [not null, default: 3, note: 'Fixed reward ratio (R:R), e.g. 3 means take profit = risk * 3']
  status strategy_status [not null, note: 'The worst status among its active StrategyCapital wallet assets']
  is_archived boolean [default: false, not null, note: 'Soft-archived strategy; hidden from active strategy views']
  Note: 'Edge layer: the fixed risk and reward coefficients of a strategy cohort. Ownership is scoped transitively through TradingProfile.owner. Capital lives per asset in StrategyCapital, so one strategy is reused across every wallet asset it allocates.'
}

Table StrategyCapital {
  id integer [pk, increment, note: 'Primary key']
  strategy_id integer [not null, note: 'Owning strategy']
  wallet_asset_id integer [not null, note: 'Wallet asset this allocation commits to; must belong to the same profile wallet as the strategy']
  capital decimal(30, 18) [not null, note: 'Fixed risk base for this asset; locked after the first submitted trade settling in it. New rows may be added when another asset becomes available.']
  is_archived boolean [default: false, not null, note: 'Soft-archived allocation; preserves historical trades while preventing new trades in this asset']
  Note: 'Allocation layer: fixed capital per wallet asset that a strategy commits. risk_amount = capital * risk_percent / 100. Ownership is scoped transitively through the strategy and profile.'
  indexes {
    (strategy_id, wallet_asset_id) [unique, name: 'strategy_capital_strategy_wallet_asset_idx', note: 'One allocation per strategy and wallet asset']
  }
}

Table Trade {
  id integer [pk, increment, note: 'Primary key']
  profile_id integer [not null, note: 'Owning profile; owner is the profile owner (single ownership root)']
  strategy_id integer [not null, note: 'Owning strategy']
  venue_instrument_id integer [not null, note: 'Shared instrument traded; references catalog directly']
  trade_date date [not null, note: 'Analytical date; source of truth for time filters']
  status trade_status [not null, note: 'Draft, pending, open, closed, or cancelled']
  direction direction [not null, note: 'Long or short; locked once the snapshot exists']
  draft_context json [not null, default: '{}', note: 'Intermediate form and calculation state saved during draft editing']
  description_markdown text [note: 'Evolving Markdown description in any state']

  review_completed_at timestamp [note: 'Optional review completion time; closed trades only']
  realized_pnl decimal(30, 18) [note: 'Final signed net P&L when closed, in the settlement asset']
  actual_exit_price decimal(30, 18) [note: 'Optional reference exit price']
  total_commission decimal(30, 18) [note: 'Optional total commission context']
  funding_result decimal(30, 18) [note: 'Optional signed funding context']
  created_at timestamp [default: `now()`, not null, note: 'Creation time']
  Note: 'Working journal record and lifecycle. Ownership is scoped transitively through TradingProfile.owner. The instrument settlement asset must match the asset of one StrategyCapital of the strategy. Decision context is frozen into TradeSnapshot on the draft-to-pending transition; Trade working fields are locked from then on.'
}

Table TradeSnapshot {
  id integer [pk, increment, note: 'Primary key']
  trade_id integer [unique, not null, note: 'One write-once snapshot per trade']
  planned_entry decimal(30, 18) [not null, note: 'Frozen planned entry price']
  planned_stop decimal(30, 18) [not null, note: 'Frozen planned stop price']
  planned_take_profit decimal(30, 18) [note: 'Frozen take profit, derived at the reward multiple']
  quantity decimal(30, 18) [note: 'Frozen position quantity']
  reward_multiple decimal(10, 6) [note: 'Frozen reward multiple from the strategy']
  planned_risk_percent decimal(10, 6) [note: 'Frozen risk percent from the strategy']
  planned_risk_amount decimal(30, 18) [note: 'Frozen monetary risk = allocation_capital * risk_percent / 100']
  planned_notional decimal(30, 18) [note: 'Frozen notional at 1x; the reserving amount while the trade is pending or open']
  allocation_capital decimal(30, 18) [note: 'Frozen StrategyCapital.capital for the settlement asset']
  risk_stop_capital decimal(30, 18) [note: 'Frozen WalletAsset.risk_stop_capital']
  already_reserved_risk decimal(30, 18) [note: 'Frozen risk already reserved by other trades of the same strategy and asset']
  remaining_risk_capacity decimal(30, 18) [note: 'Frozen remaining risk capacity for the strategy and asset']
  deposit_floor_breach boolean [note: 'Frozen deposit-floor breach state']
  wallet_balance decimal(30, 18) [note: 'Frozen wallet balance']
  wallet_reserved decimal(30, 18) [note: 'Frozen already-reserved notional']
  wallet_available decimal(30, 18) [note: 'Frozen available balance']
  atr_value decimal(30, 18) [note: 'Frozen ATR value']
  atr_source atr_source [note: 'AUTO from live provider candles, or MANUAL entered value']
  atr_contributing_date date [note: 'Last date contributing to the ATR snapshot']
  atr_observation_time timestamp [note: 'When the ATR context was observed']
  atr_stale boolean [note: 'True if the snapshot context is stale']
  created_at timestamp [default: `now()`, not null, note: 'Write-once creation time']
  Note: 'Immutable decision context written atomically on the draft-to-pending transition. Its planned_notional backs the derived wallet reservation while the trade is pending or open. Ownership is scoped transitively through the trade and its profile.'
}

Table Attachment {
  id integer [pk, increment, note: 'Primary key']
  trade_id integer [not null, note: 'Owning trade; owner scoped through its profile']
  storage_key varchar(255) [unique, not null, note: 'Server-generated relative path below the private media root']
  original_name varchar(255) [not null, note: 'Sanitized client filename for display and download']
  content_type varchar(127) [not null, note: 'Verified supported image media type']
  size_bytes integer [not null, note: 'Exact stored payload size']
  created_at timestamp [default: `now()`, not null, note: 'Upload time']
  Note: 'Private trade image metadata. Files live outside the database and are served only after owner authorization.'
}

// ---------------------------------------------------------------------------
// Relations
// ---------------------------------------------------------------------------

Ref: TradingPair.base_id > Asset.id
Ref: TradingPair.quote_id > Asset.id

Ref: VenueInstrument.venue_id > Venue.id
Ref: VenueInstrument.pair_id > TradingPair.id
Ref: VenueInstrument.settlement_asset_id > Asset.id

Ref: VenueWalletAsset.venue_id > Venue.id
Ref: VenueWalletAsset.asset_id > Asset.id

Ref: TradingProfile.owner_id > users.id
Ref: TradingProfile.venue_id > Venue.id
Ref: Wallet.profile_id > TradingProfile.id
Ref: WalletAsset.wallet_id > Wallet.id
Ref: WalletAsset.venue_wallet_asset_id > VenueWalletAsset.id
Ref: WalletOperation.wallet_asset_id > WalletAsset.id

Ref: TradingStrategy.profile_id > TradingProfile.id
Ref: StrategyCapital.strategy_id > TradingStrategy.id
Ref: StrategyCapital.wallet_asset_id > WalletAsset.id

Ref: Trade.profile_id > TradingProfile.id
Ref: Trade.strategy_id > TradingStrategy.id
Ref: Trade.venue_instrument_id > VenueInstrument.id

Ref: TradeSnapshot.trade_id > Trade.id
Ref: Attachment.trade_id > Trade.id
