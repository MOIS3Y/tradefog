#: src/tradefog/journal/calculations.py:78
msgid "Entry must be positive."
msgstr "Цена входа должна быть положительной."

#: src/tradefog/journal/calculations.py:80
msgid "Stop must be positive."
msgstr "Цена стопа должна быть положительной."

#: src/tradefog/journal/calculations.py:84
msgid "The profile does not currently provide positive trade risk."
msgstr "Профиль сейчас не предоставляет положительного торгового риска."

#: src/tradefog/journal/calculations.py:89
msgid "Entry must be aligned with the instrument price step."
msgstr "Цена входа должна соответствовать шагу цены инструмента."

#: src/tradefog/journal/calculations.py:94
msgid "Stop must be aligned with the instrument price step."
msgstr "Цена стопа должна соответствовать шагу цены инструмента."

#: src/tradefog/journal/calculations.py:102
msgid "A LONG stop must be below the entry price."
msgstr "Для LONG стоп должен быть ниже цены входа."

#: src/tradefog/journal/calculations.py:110
msgid "A SHORT stop must be above the entry price."
msgstr "Для SHORT стоп должен быть выше цены входа."

#: src/tradefog/journal/calculations.py:116
msgid "The calculated SHORT take profit must remain positive."
msgstr "Рассчитанный тейк-профит SHORT должен оставаться положительным."

#: src/tradefog/journal/calculations.py:119
msgid "Select a trade direction."
msgstr "Выберите направление сделки."

#: src/tradefog/journal/calculations.py:128
msgid "Risk and stop distance produce a quantity below one step."
msgstr "Риск и расстояние до стопа дают объём меньше одного шага."

#: src/tradefog/journal/calculations.py:133
msgid "Calculated quantity is below the instrument minimum."
msgstr "Рассчитанный объём ниже минимального для инструмента."

#: src/tradefog/journal/calculations.py:143
msgid "Calculated order value is below the instrument minimum."
msgstr "Рассчитанная стоимость заявки ниже минимальной для инструмента."

