msgid "Ratio"
msgstr "Соотношение"

#: src/tradefog/templates/tradefog/trades/partials/no_profile_modal.html
msgid "Trading profile required"
msgstr "Требуется торговый профиль"

#: src/tradefog/templates/tradefog/trades/partials/no_profile_modal.html
msgid ""
"A trade belongs to a trading profile. Create your first profile with a venue "
"and wallet to start journaling trades."
msgstr ""
"Сделка привязана к торговому профилю. Создайте первый профиль с площадкой и "
"кошельком, чтобы начать вести журнал сделок."

#: src/tradefog/templates/tradefog/trades/partials/no_profile_modal.html
msgid "Go to profiles"
msgstr "Перейти к профилям"

#: src/tradefog/journal/views/trades/workspace.py
msgid "Create a trading profile before starting a new trade."
msgstr "Создайте торговый профиль перед добавлением сделки."
