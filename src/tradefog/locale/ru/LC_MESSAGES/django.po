msgstr "Черновик сделки успешно создан."

#: src/tradefog/journal/views/trades/workspace.py
msgid "Trade draft updated."
msgstr "Черновик сделки обновлён."

#: src/tradefog/templates/tradefog/trades/partials/position_plan.html
msgid "Position value exceeds available wallet funds."
msgstr "Объём позиции превышает доступные средства кошелька."

#: src/tradefog/templates/tradefog/trades/partials/checklist_assessment.html
msgid "Global and local D1 observations are divergent."
msgstr "Глобальные и локальные наблюдения D1 расходятся."

#: src/tradefog/templates/tradefog/trades/partials/checklist_assessment.html
msgid "Global and local D1 observations are mixed."
msgstr "Глобальные и локальные наблюдения D1 смешанные."

