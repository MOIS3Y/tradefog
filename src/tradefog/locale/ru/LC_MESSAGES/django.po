msgid "English"
msgstr "Английский"

msgid "Russian"
msgstr "Русский"

msgid "Entry must be positive."
msgstr "Цена входа должна быть положительной."

msgid "Stop must be positive."
msgstr "Цена стопа должна быть положительной."

msgid "The profile does not currently provide positive trade risk."
msgstr "Сейчас профиль не предоставляет положительный риск на сделку."

msgid "Entry must be aligned with the instrument price step."
msgstr "Цена входа должна соответствовать шагу цены инструмента."

msgid "Stop must be aligned with the instrument price step."
msgstr "Цена стопа должна соответствовать шагу цены инструмента."

msgid "A LONG stop must be below the entry price."
msgstr "Стоп для LONG должен быть ниже цены входа."

msgid "A SHORT stop must be above the entry price."
msgstr "Стоп для SHORT должен быть выше цены входа."

msgid "The calculated SHORT take profit must remain positive."
msgstr "Рассчитанный тейк-профит для SHORT должен быть положительным."

msgid "Select a trade direction."
msgstr "Выберите направление сделки."

msgid "Risk and stop distance produce a quantity below one step."
msgstr "Риск и расстояние до стопа дают количество меньше одного шага."

msgid "Calculated quantity is below the instrument minimum."
msgstr "Рассчитанное количество меньше минимума для инструмента."

msgid "Calculated order value is below the instrument minimum."
msgstr "Рассчитанная стоимость ордера меньше минимума для инструмента."

msgid "Capital asset is locked because trading pairs exist."
msgstr "Актив капитала заблокирован, поскольку в профиле есть торговые пары."

msgid "Market type is locked because trading pairs exist."
msgstr "Тип рынка заблокирован, поскольку в профиле есть торговые пары."

msgid "Initial capital is locked because a trade was submitted."
msgstr "Начальный капитал зафиксирован, поскольку одна из сделок отправлена."

msgid "Risk per trade is locked because a trade was submitted."
msgstr "Риск на сделку зафиксирован, поскольку одна из сделок отправлена."

msgid "Risk stop must be lower than current capital."
msgstr "Порог остановки должен быть ниже текущего капитала."

msgid "Deposit amount"
msgstr "Сумма пополнения"

msgid "Withdrawal amount"
msgstr "Сумма вывода"

msgid "The smallest allowed change in the quoted price."
msgstr "Минимально допустимое изменение цены инструмента."

msgid "The smallest allowed change in the order quantity."
msgstr "Минимально допустимое изменение количества в ордере."

msgid "Leave empty when the market has no minimum quantity."
msgstr "Оставьте пустым, если для рынка нет минимального объёма."

msgid "Trading pair"
msgstr "Торговая пара"

msgid "Realized P&L"
msgstr "Реализованный P&L"

msgid "Net result including fees, slippage, and manual exits."
msgstr "Итоговый результат с учётом комиссий, проскальзывания и ручных выходов."

msgid "Actual exit price"
msgstr "Фактическая цена выхода"

msgid "Optional reference price for the fully closed position."
msgstr "Необязательная справочная цена полностью закрытой позиции."

msgid "Commission"
msgstr "Комиссия"

msgid "Optional reference amount already included in net P&L."
msgstr "Необязательная справочная сумма, уже включённая в чистый P&L."

msgid "Funding result"
msgstr "Результат фандинга"

msgid "Optional signed amount already included in net P&L: negative when paid, positive when received."
msgstr "Необязательная знаковая сумма, уже включённая в чистый P&L: отрицательная при оплате и положительная при получении."

msgid "Use letters, numbers, dots, underscores, or hyphens."
msgstr "Используйте буквы, цифры, точки, подчёркивания или дефисы."

msgid "An active trading pair already uses this asset."
msgstr "Этот актив уже используется активной торговой парой."

msgid "Capital asset is locked after the first trading pair."
msgstr "Актив капитала блокируется после добавления первой торговой пары."

msgid "Market type is locked after the first trading pair."
msgstr "Тип рынка блокируется после добавления первой торговой пары."

msgid "Asset symbol is locked while the asset is in use."
msgstr "Символ актива нельзя изменить, пока актив используется."

msgid "The execution provider cannot be changed."
msgstr "Способ исполнения нельзя изменить."

msgid "Initial capital is locked after the first submitted trade."
msgstr "Начальный капитал фиксируется после первой отправленной сделки."

msgid "Risk per trade is locked after the first submitted trade."
msgstr "Риск на сделку фиксируется после первой отправленной сделки."

