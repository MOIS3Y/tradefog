{
  "name": "tradefog-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.d.ts",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write --ignore-path ../.gitignore .",
    "format:check": "prettier --check --ignore-path ../.gitignore .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@lucide/vue": "^1.42.0",
    "@tanstack/vue-query": "^5.90.0",
    "openapi-fetch": "^0.15.0",
    "pinia": "^3.0.0",
    "reka-ui": "^2.6.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.0.0",
    "sass": "^1.86.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
